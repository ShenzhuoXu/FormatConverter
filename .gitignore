# -----------------------------------------------------------------------------
# 1. 项目特定忽略
# -----------------------------------------------------------------------------

# 忽略存放原始 PDF 文件的目录，这些是输入数据，不应纳入版本控制
# 这也可以保护隐私
/pdfs/

# 忽略由 pymupdf4llm 生成的 Markdown 文件
/mds/

# 忽略由 marker-pdf 生成的输出目录
/output_markdown/

# 忽略 Markdown 清理脚本生成的备份文件
*.bak.md

# Web 临时目录占位（后续 Web Step 会具体化，先忽略常见上传/输出目录）
web_uploads/
web_outputs/


# -----------------------------------------------------------------------------
# 2. Python 通用忽略
# -----------------------------------------------------------------------------

# Python 字节码和缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# Python 虚拟环境 (常见名称)
# 如果你的虚拟环境文件夹名称不同，请添加到这里
.venv/
venv/
env/
ENV/
.env/
# 环境变量文件（.env 是文件，区别于上面的 .env/ 目录）
.env

# 打包和分发目录
dist/
build/
*.egg-info/
*.egg

# 单元测试和覆盖率报告
.pytest_cache/
# pytest --basetemp 测试临时目录
.pytest-tmp/
htmlcov/
.coverage
.coverage.*


# -----------------------------------------------------------------------------
# 3. 操作系统和编辑器特定忽略
# -----------------------------------------------------------------------------

# 操作系统生成的文件
.DS_Store
Thumbs.db
ehthumbs.db

# 编辑器/IDE 配置文件
# 注：git 2.53 中，规则行末尾的 "# 注释" 会导致该规则整体失效，
# 因此注释统一放在单独的行里，避免影响规则匹配。
.idea/
.vscode/
